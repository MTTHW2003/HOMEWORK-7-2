
def gcd(a, b):
    while b != 0:
        remainder = a % b
        a = b
        b = remainder

    return a


def phi(n):
    numbers = []

    if n == 1:
        numbers.append(1)
    else:
        for k in range(1, n):
            if gcd(n, k) == 1:
                numbers.append(k)

    return numbers


def main():
    n = int(input("Enter a positive integer: "))

    if n <= 0:
        print("Please enter a positive integer.")
    else:
        result = phi(n)

        print("Numbers relatively prime to", n, ":")
        print(result)

        print("Euler's Totient:", len(result))


main()
